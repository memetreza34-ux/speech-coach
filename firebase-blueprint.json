{
  "rules_version": "2",
  "collections": [
    {
      "name": "users",
      "path": "/users/{userId}",
      "description": "User profiles and subscription state.",
      "schema": {
        "name": "string",
        "role": "string",
        "age": "string",
        "hobbies": "string",
        "isPremium": "boolean",
        "createdAt": "timestamp",
        "isOnboarded": "boolean",
        "onboardingGoal": "string",
        "onboardingFrequency": "string",
        "customModes": "array"
      },
      "permissions": {
        "read": "userId == request.auth.uid",
        "create": "userId == request.auth.uid",
        "update": "userId == request.auth.uid && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium']))"
      },
      "subcollections": []
    },
    {
      "name": "sessions",
      "path": "/users/{userId}/sessions/{sessionId}",
      "description": "User speaking practice sessions.",
      "schema": {
        "mode": "string",
        "modeLabel": "string",
        "date": "timestamp",
        "sessionType": "string",
        "durationMs": "number",
        "fillers": "number",
        "wpm": "number",
        "pauseCount": "number",
        "longestPauseMs": "number",
        "dynamics": "number",
        "speakingRatio": "number",
        "confidenceScore": "number",
        "pacingStatus": "string",
        "transcript": "string",
        "aiTip": "object"
      },
      "permissions": {
        "read": "userId == request.auth.uid",
        "create": "userId == request.auth.uid",
        "update": "userId == request.auth.uid",
        "delete": "userId == request.auth.uid"
      },
      "subcollections": []
    }
  ]
}
