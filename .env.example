# Server-side only. Never expose this value through VITE_* variables.
OPENAI_API_KEY=your_openai_api_key

# Optional model override. The server endpoint defaults to gpt-5.
OPENAI_MODEL=gpt-5

# Optional server-side origin allowlist for API calls. Same-origin browser calls
# are accepted automatically. Use comma-separated origins only when a deployment
# intentionally needs additional frontend origins.
SPEECHCOACH_ALLOWED_ORIGINS=https://speechcoach.example

# Frontend-safe Supabase connection values. Use a publishable key, never a
# service_role or secret key. The repository includes the connected development
# project as a fallback; these variables allow deployment-specific overrides.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
